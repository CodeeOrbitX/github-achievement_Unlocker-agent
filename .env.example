# ═══════════════════════════════════════════════════════════════
# GitHub Achievement Agent — Environment Configuration
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your GitHub Personal Access Tokens.
# NEVER commit your .env file to version control.
#
# Required token scopes:
#   repo          — Full control of private and public repositories
#   user          — Read/write access to profile info
#   read:user     — Read-only access to profile info (minimum)
#
# How to create a PAT:
#   https://github.com/settings/tokens/new
#   Select: repo, user, read:user, read:org (optional)
#
# ═══════════════════════════════════════════════════════════════

# ── GitHub Account Tokens ─────────────────────────────────────
# Primary account (required)
GITHUB_TOKEN_1=

# Secondary account for Pair Extraordinaire (optional)
GITHUB_TOKEN_2=

# ── Action Budget (conservative defaults) ─────────────────────
# Maximum GitHub API mutations per hour per account
BUDGET_MUTATIONS_PER_HOUR=5

# Maximum test issues created per day (Quickdraw)
BUDGET_ISSUES_PER_DAY=1

# Maximum automated PRs per day (Pull Shark, YOLO)
BUDGET_PRS_PER_DAY=3

# ── Safety Controls ───────────────────────────────────────────
# Stop automation on GitHub rate limit response
SAFETY_STOP_ON_RATE_LIMIT=true

# Stop automation on abuse detection signal
SAFETY_STOP_ON_ABUSE=true

# Stop automation on CAPTCHA detection
SAFETY_STOP_ON_CAPTCHA=true

# Stop automation on suspicious activity detection
SAFETY_STOP_ON_SUSPICIOUS=true

# ── App Settings ──────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite database path (relative to project root)
DATABASE_PATH=agent.db

# Prefix for automation-related repository names
AUTOMATION_REPO_PREFIX=achievement-automation
